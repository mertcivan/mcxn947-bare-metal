{
    // The Makefile uses POSIX recipes (rm -rf, mkdir -p), which cmd.exe and
    // PowerShell do not provide. Build tasks therefore run through Git Bash.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
            "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": ["-c"]
        }
    },
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "make clean && make",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "size",
            "type": "shell",
            "command": "make size",
            "problemMatcher": []
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "make flash",
            "dependsOn": "stop-debug-servers",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            // The MCU-Link probe can only be claimed by one debugger at a time,
            // and a LinkServer left running holds both the probe and port 3333.
            // Every debug launch clears them first, so a crashed or orphaned
            // session never blocks the next one.
            "label": "stop-debug-servers",
            "type": "shell",
            "command": "Get-Process LinkServer,redlinkserv,crt_emu_cm_redlink -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 700; exit 0",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "prep-debug",
            "dependsOrder": "sequence",
            "dependsOn": ["stop-debug-servers", "build"],
            "problemMatcher": []
        },
        {
            // Background server for the cortex-debug "external" launch config.
            "label": "gdbserver",
            "type": "shell",
            "command": "'C:/nxp/LinkServer_26.6.137/LinkServer.exe' gdbserver --gdb-port 3333 MCXN947:FRDM-MCXN947",
            "dependsOn": "prep-debug",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
                "background": {
                    "activeOnStart": true,
                    // beginsPattern must NOT match any line LinkServer prints
                    // after it is ready, or the task flips back to "running"
                    // and the launch waits forever. "Selected probe" appears
                    // once, early; the trailing "INFO: [stub ...] LinkServer
                    // RedlinkMulti Driver" line is why ".*" cannot be used.
                    "beginsPattern": "Selected probe",
                    "endsPattern": "GDB server listening on port"
                }
            },
            "presentation": { "reveal": "silent", "panel": "dedicated" }
        }
    ]
}

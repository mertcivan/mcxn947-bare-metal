{
    "version": "0.2.0",
    "configurations": [
        {
            // Needs only the C/C++ extension. Builds, clears any orphaned
            // LinkServer, then starts its own gdbserver.
            "name": "Debug (LinkServer, cppdbg)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mcxn947-bare-metal.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/mertcivan/.mcuxpressotools/arm-gnu-toolchain-14.2.rel1-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "miDebuggerServerAddress": "localhost:3333",
            "debugServerPath": "C:/nxp/LinkServer_26.6.137/LinkServer.exe",
            "debugServerArgs": "gdbserver --gdb-port 3333 MCXN947:FRDM-MCXN947",
            // LinkServer prints this on stdout when ready; its INFO lines go
            // to stderr, hence filterStderr.
            "serverStarted": "GDB server listening on port",
            "filterStderr": true,
            "filterStdout": false,
            "stopAtConnect": true,
            "preLaunchTask": "prep-debug",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set mem inaccessible-by-default off", "ignoreFailures": true }
            ],
            "postRemoteConnectCommands": [
                { "text": "load" },
                { "text": "monitor reset" },
                { "text": "tbreak main" }
            ]
        },
        {
            // Preferred: reads svd/ and shows peripheral registers by name with
            // decoded bit fields. The gdbserver task starts the server and
            // itself depends on prep-debug, so one F5 does everything.
            "name": "Debug (cortex-debug + SVD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/mcxn947-bare-metal.elf",
            "device": "MCXN947",
            "svdFile": "${workspaceFolder}/svd/MCXN947cm33_core0.xml",
            "gdbPath": "C:/Users/mertcivan/.mcuxpressotools/arm-gnu-toolchain-14.2.rel1-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "runToEntryPoint": "main",
            "preLaunchTask": "gdbserver",
            "overrideLaunchCommands": [
                "load",
                "monitor reset"
            ]
        }
    ]
}
